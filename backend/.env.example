APP_NAME=HackVerse API
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://hackverse:hackverse@localhost:5432/hackverse
REDIS_URL=redis://localhost:6379/0

# Outside APP_ENV=local/test the app refuses to boot with these defaults:
# SESSION_SECRET must be >=32 random characters and SESSION_COOKIE_SECURE must
# be true. A deploy that silently kept "change-me" would let anyone forge a
# session cookie for any user, including organizers.
SESSION_SECRET=change-me-in-local-development
SESSION_COOKIE_NAME=hackverse_session
SESSION_TTL_SECONDS=259200
SESSION_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:5173

# Extra origins allowed for CORS and the WebSocket handshake, as a JSON array.
# FRONTEND_BASE_URL is always included. WebSocket upgrades bypass CORS, so this
# list is what prevents cross-site WebSocket hijacking.
ALLOWED_ORIGINS=[]

# Database pool. Every WebSocket message that touches Postgres borrows from
# this pool; SQLAlchemy's default of 5 saturates under event load.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# Realtime tuning.
PRESENCE_TTL_SECONDS=60
MOVEMENT_RATE_LIMIT_PER_SECOND=20
CHAT_RATE_LIMIT_PER_MINUTE=30
INTERACT_RATE_LIMIT_PER_MINUTE=60
CHAT_MAX_LENGTH=2000
PROXIMITY_TILE_RADIUS=3
INTEREST_RADIUS_TILES=20
MAX_MEDIA_PEERS=6
WORLD_MAX_COORDINATE=100000

# Assets. We author the campus map and serve it from backend/assets, so no
# object storage is provisioned. Point this at a CDN origin to front it;
# leave blank to serve from the API.
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=8388608

# Chat retention in days, enforced by app.workers.cleanup. 0 disables it.
CHAT_RETENTION_DAYS=30

# WebRTC. Without a TURN relay, media fails on restrictive college networks —
# the PRD's highest-ranked technical risk. TURN_SHARED_SECRET must match
# coturn's static-auth-secret when running with use-auth-secret.
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Gamification appears in neither the PRD nor the implementation plan, so it is
# off until that product question is settled.
ENABLE_GAMIFICATION=false
